{
  "name": "p-np-patcher",
  "version": "4.4.1",
  "description": "Fetches and patches Prodigy game files for static hosting",
  "main": "./dist/patch.js",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "patch": "node dist/patch.js",
    "test": "node --experimental-strip-types --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProdigyPXP/P-NP.git"
  },
  "author": "ProdigyPXP",
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/ProdigyPXP/P-NP/issues"
  },
  "homepage": "https://github.com/ProdigyPXP/P-NP#readme",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
